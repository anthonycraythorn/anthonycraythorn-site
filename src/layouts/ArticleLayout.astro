---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} image={frontmatter.image ?? '/images/blog-break-into-musical-theatre-sound.jpg'}>
  <article class="article">
    <p class="eyebrow">{frontmatter.date}</p>
    <slot />
  </article>
</BaseLayout>
