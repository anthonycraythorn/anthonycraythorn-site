---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Anthony Craythorn Sound Design',
  description = 'Melbourne sound engineer, mix engineer and sound designer specialising in musical theatre, live performance, vocal recording, mixing and mastering.',
  image = '/images/anthony-headshot.jpg',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.anthonycraythorn.com').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? 'https://www.anthonycraythorn.com').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/">ANTHONY CRAYTHORN SOUND DESIGN</a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/studio">Studio</a>
          <a href="/live">Live</a>
          <a href="/contact">Contact</a>
          <a href="https://www.instagram.com/anthony.craythorn/" aria-label="Instagram">Instagram</a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-wrap">
        <strong>Anthony Craythorn Sound Design</strong>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/studio">Studio</a>
          <a href="/live">Live</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
