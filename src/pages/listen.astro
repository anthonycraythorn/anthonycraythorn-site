---
import BaseLayout from '../layouts/BaseLayout.astro';
import SamplyDashboard from '../components/SamplyDashboard';
---
<BaseLayout title="Listen — Anthony Craythorn Sound Design" description="Selected audio samples, mixes and studio work by Anthony Craythorn.">
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Selected work</p>
        <h1>Listen</h1>
        <p class="lede">Selected studio work, mixes and musical projects in one place — a quick way to hear the detail, energy and emotional shape I aim for in a finished track.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">Audio dashboard</p>
      <h2>Mixes, songs and sound samples</h2>
      <p class="light-lede">A small sample of my work across studio mixing, vocal production and musical theatre-adjacent projects.</p>
      <SamplyDashboard client:load />
    </div>
  </section>
</BaseLayout>
