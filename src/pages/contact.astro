---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Anthony Craythorn Sound Design" description="Contact Anthony Craythorn for studio mixing, vocal recording, mastering and live sound enquiries.">
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">Contact</p>
      <h1>Contact</h1>
      <p class="light-lede">Please get in touch via the form and I will get back to you ASAP.</p>
      <form id="contact-form" class="form-card" name="contact" method="POST" action="/thanks/" data-netlify="true" data-netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="subject" value="New website enquiry from anthonycraythorn.com" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="field-grid">
          <label>First name <input name="first-name" autocomplete="given-name" required /></label>
          <label>Last name <input name="last-name" autocomplete="family-name" required /></label>
        </div>
        <label>Email <input type="email" name="email" autocomplete="email" required /></label>
        <label>Enquiry type
          <select name="enquiry-type">
            <option>Studio mixing / mastering</option>
            <option>Vocal recording</option>
            <option>Live sound / sound design</option>
            <option>General enquiry</option>
          </select>
        </label>
        <label>Message <textarea name="message" required></textarea></label>
        <button class="button dark" type="submit">Submit</button>
      </form>
      <script>
        const form = document.querySelector('#contact-form');
        form?.addEventListener('submit', async (event) => {
          event.preventDefault();

          try {
            const formData = new FormData(form);
            const response = await fetch('/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams(formData).toString(),
            });

            if (!response.ok) throw new Error(`Form submission failed: ${response.status}`);
            window.location.href = '/thanks/';
          } catch (error) {
            console.error(error);
            alert('Sorry, something went wrong while sending the form. Please email me directly or try again shortly.');
          }
        });
      </script>
    </div>
  </section>
</BaseLayout>
