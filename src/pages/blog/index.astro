---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog — Anthony Craythorn Sound Design" description="Writing about musical theatre sound, mixing and practical career advice.">
  <section class="hero">
    <div class="section-inner">
      <p class="eyebrow">Blog</p>
      <h1>Notes on sound.</h1>
      <p class="lede">Writing about musical theatre sound, mixing and the practical realities of building a career in the industry.</p>
    </div>
  </section>
  <section class="section">
    <div class="section-inner split">
      <a class="show-card" href="/blog/break-into-musical-theatre-sound">
        <img src="/images/blog-break-into-musical-theatre-sound.jpg" alt="Backstage musical theatre sound setup" />
        <div>
          <h3>Break Into Musical Theatre Sound</h3>
          <p>There’s no road map for breaking into Musical Theatre Sound. Here are the steps I wish someone had given me.</p>
        </div>
      </a>
      <div class="card">
        <h3>Newsletter</h3>
        <p>Receive new posts and updates. This can be connected to your preferred newsletter platform later.</p>
        <a class="button dark" href="/contact">Ask about updates</a>
      </div>
    </div>
  </section>
</BaseLayout>
