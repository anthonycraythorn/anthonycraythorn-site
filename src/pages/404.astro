---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Anthony Craythorn Sound Design">
  <section class="section">
    <div class="section-inner card">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="light-lede">That page doesn't exist. Try the Studio, Listen or Contact pages.</p>
      <div class="actions">
        <a class="button dark" href="/studio">Studio</a>
        <a class="button light-ghost" href="/listen">Listen</a>
        <a class="button light-ghost" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
